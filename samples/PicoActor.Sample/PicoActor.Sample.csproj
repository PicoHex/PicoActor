<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PublishAot>true</PublishAot>
    <TrimMode>full</TrimMode>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PicoActor\PicoActor.csproj" />
    <!-- Bridge-generated code needs the PicoMediator runtime (MediatorAutoSubscriptionRegistry) + PicoDI -->
    <PackageReference Include="PicoMediator" />
    <PackageReference Include="PicoMediator.DI" />
    <PackageReference Include="PicoDI" />
    <PackageReference Include="PicoDI.Abs" />
  </ItemGroup>
</Project>