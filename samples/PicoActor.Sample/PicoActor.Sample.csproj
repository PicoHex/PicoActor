<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <!-- Production-configuration preview: minimal tier + size levers -->
    <AotOptimizationLevel>aggressive</AotOptimizationLevel>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PicoActor\PicoActor.csproj" />
    <ProjectReference Include="..\..\src\PicoActor.EventStore.InMemory\PicoActor.EventStore.InMemory.csproj" />
    <!-- The durable store: its PicoJetson reference flows here, so the [PicoDerivedType]
         registration in this assembly is what generates the sample's serializer. -->
    <ProjectReference Include="..\..\src\PicoActor.EventStore.Jsonl\PicoActor.EventStore.Jsonl.csproj" />
    <!-- 本地开发:analyzer 不随 ProjectReference 传递(镜像 tests/PicoActor.Tests 模式;
         NuGet 消费者经 PicoActor.Abs 包的 buildTransitive props 自动注入) -->
    <ProjectReference
      Include="..\..\src\PicoActor.Gen\PicoActor.Gen.csproj"
      OutputItemType="Analyzer"
    />
    <!-- Bridge-generated code needs the PicoMediator runtime (MediatorAutoSubscriptionRegistry) + PicoDI -->
    <PackageReference Include="PicoMediator" />
    <PackageReference Include="PicoMediator.DI" />
    <PackageReference Include="PicoDI" />
    <PackageReference Include="PicoDI.Abs" />
  </ItemGroup>
</Project>
