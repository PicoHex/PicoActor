<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Deterministic>true</Deterministic>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.11" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.400" />
    <PackageVersion Include="PicoActor" Version="$(Version)" />
    <PackageVersion Include="PicoActor.Abs" Version="$(Version)" />
    <PackageVersion Include="PicoDI" Version="2026.9.0" />
    <PackageVersion Include="PicoDI.Abs" Version="2026.9.0" />
    <PackageVersion Include="PicoLog.Abs" Version="2026.9.0" />
    <PackageVersion Include="PicoMediator" Version="2026.9.0" />
    <PackageVersion Include="PicoMediator.Abs" Version="2026.9.0" />
    <PackageVersion Include="PicoMediator.DI" Version="2026.9.0" />
    <PackageVersion Include="System.Threading.Channels" Version="10.0.11" />
    <PackageVersion Include="TUnit" Version="1.65.38" />
  </ItemGroup>
</Project>
