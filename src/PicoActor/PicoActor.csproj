<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageId>PicoActor</PackageId>
    <Description>In-memory Actor runtime for PicoNode. Provides ActorSystem (IActorSystem implementation), InMemoryEventStore, and PicoDI integration.</Description>
    <PackageTags>PicoHex;PicoNode;AOT;Actor;ActorModel;EventSourcing</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PicoActor.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="PicoDI.Abs" PrivateAssets="Build" />
    <PackageReference Include="PicoLog.Abs" PrivateAssets="Build" />
    <PackageReference Include="PicoMediator.Abs" PrivateAssets="Build" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseProjectReferences)' == 'true'">
    <!-- PrivateAssets=Build: let Abs's buildTransitive analyzer flow downstream
         (nuspec edge would otherwise become exclude="Build,Analyzers") -->
    <ProjectReference Include="..\PicoActor.Abs\PicoActor.Abs.csproj" PrivateAssets="Build" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseProjectReferences)' != 'true'">
    <PackageReference Include="PicoActor.Abs" PrivateAssets="Build" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>
</Project>
