<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageId>PicoActor.Abs</PackageId>
    <Description>Core abstractions for PicoActor in-memory actor framework. Targets net10.0 (PicoMediator runtime + generated bridge code require net10.0+).</Description>
    <PackageTags>PicoHex;PicoNode;AOT;Actor;ActorModel;Abstractions</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PicoActor.Abs.Tests" />
    <InternalsVisibleTo Include="PicoActor.Tests" />
    <InternalsVisibleTo Include="PicoNode.Agent.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- IDomainEvent : IEvent 的基接口需传递(消费者编译时解析) -->
    <PackageReference Include="PicoMediator.Abs" />
    <!-- These two are NOT private: the shipped DLL needs them at consumer compile AND
         run time, so the package must declare them as dependencies.
         · PicoMediator — the [ModuleInitializer] emitted by PicoMediator.Gen into
           PicoActor.Abs calls MediatorEventDispatchers_PicoActor_Abs.AutoRegister(),
           which resolves PicoMediator.MediatorAutoSubscriptionRegistry. Hiding it
           produced TypeInitializationException -> FileNotFoundException: PicoMediator
           on the first touch of any Abs type (fixed in C1).
         · PicoDI.Abs — ISvcContainer appears in shipped generated code (and in the
           public AddPicoActor(...) signature), so consumers must resolve it too. -->
    <PackageReference Include="PicoMediator" />
    <PackageReference Include="PicoDI.Abs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\PicoActor.Gen\PicoActor.Gen.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      PrivateAssets="all"
    />
  </ItemGroup>

  <ItemGroup>
    <None
      Include="..\PicoActor.Gen\bin\$(Configuration)\netstandard2.0\PicoActor.Gen.dll"
      Pack="true"
      PackagePath="analyzers/dotnet/cs"
      Visible="false"
    />
    <None
      Include="buildTransitive\PicoActor.Abs.props"
      Pack="true"
      PackagePath="buildTransitive\PicoActor.Abs.props"
      Visible="false"
    />
  </ItemGroup>
</Project>
