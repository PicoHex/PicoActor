<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>false</PublishAot>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageId>PicoActor.Abs</PackageId>
    <Description>Core abstractions for PicoActor in-memory actor framework. Targets net10.0 (PicoMediator runtime + generated bridge code require net10.0+).</Description>
    <PackageTags>PicoHex;PicoNode;AOT;Actor;ActorModel;Abstractions</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PicoActor.Abs.Tests" />
    <InternalsVisibleTo Include="PicoActor" />
    <InternalsVisibleTo Include="PicoActor.Tests" />
    <InternalsVisibleTo Include="PicoNode.Agent.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- IDomainEvent : IEvent 的基接口需传递(消费者编译时解析) -->
    <PackageReference Include="PicoMediator.Abs" />
    <!-- 2026.8.1+ 的 bridge 生成代码引用主包 MediatorAutoSubscriptionRegistry + PicoDI.Abs——
         仅生成代码内部使用,不进入公共 API,PrivateAssets=all 保持包面干净 -->
    <PackageReference Include="PicoMediator" PrivateAssets="all" />
    <PackageReference Include="PicoDI.Abs" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>
</Project>
