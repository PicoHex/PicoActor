<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PublishAot>false</PublishAot>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageId>PicoActor.Abs</PackageId>
    <Description>Core abstractions for PicoActor in-memory actor framework. Targets netstandard2.0 for maximum compatibility.</Description>
    <PackageTags>PicoHex;PicoNode;AOT;Actor;ActorModel;Abstractions</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PicoActor.Abs.Tests" />
    <InternalsVisibleTo Include="PicoActor" />
    <InternalsVisibleTo Include="PicoActor.Tests" />
    <InternalsVisibleTo Include="PicoNode.Agent.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Threading.Channels" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="PicoMediator.Abs" />
  </ItemGroup>
  <Target Name="ExcludePicoMediatorGenAnalyzer" BeforeTargets="CoreCompile">
    <!-- 2026.8.1 的 bridge 生成代码引用 PicoMediator 主包(net10.0)/PicoDI.Abs/ModuleInitializer——
         netstandard2.0 零依赖的 Abs 无法编译生成产物。排除 analyzer 阻止 bridge 生成
         (NuGet analyzer 资产在构建期多个 target 注入,须在 CoreCompile 前移除)。 -->
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'PicoMediator.Gen'" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>
</Project>