<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- Belt-and-suspenders: the shared netstandard2.0 guard in Directory.Build.targets
         covers forgotten projects, this blocks inheritance at the project level too. -->
    <PublishAot>false</PublishAot>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <NoWarn>$(NoWarn);RS2008;RS1041;NU5128</NoWarn>
    <!-- Embedded into PicoActor.Abs's package (analyzers/dotnet/cs + buildTransitive
         props): Gen is never packed standalone, so it carries no packaging metadata
         and no Pack items. -->
    <IsPackable>false</IsPackable>
    <Description>Source generator for PicoActor — declare-and-subscribe domain event handlers</Description>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <MSBuildWarningsAsMessages>MSB3026</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>
</Project>
