<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- CS0436: the Mediator bridge generator emits a dispatcher per assembly — Abs's copy and
         this assembly's copy are both visible; each caller uses its own, which is correct. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" />
    <!-- PicoActor: FindAggregateIds_UsesAsyncEnumerator drives the runtime's recovery path,
         not just the store (the enumerator is consumed by ActorSystem). -->
    <ProjectReference Include="..\..\src\PicoActor\PicoActor.csproj" />
    <ProjectReference Include="..\..\src\PicoActor.EventStore.InMemory\PicoActor.EventStore.InMemory.csproj" />
    <ProjectReference Include="..\PicoActor.TestSupport\PicoActor.TestSupport.csproj" />
  </ItemGroup>
</Project>
