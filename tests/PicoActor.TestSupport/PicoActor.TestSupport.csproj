<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <!-- A plain library, not a test host: it carries the [Test] conformance base that store
         test projects inherit. TUnit's props would otherwise force OutputType=Exe and
         IsTestProject=true, so both are re-declared here (props are imported before the body). -->
    <OutputType>Library</OutputType>
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" />
    <!-- PicoJetson: this project is a REGISTRATION CONSUMER, not a serializer consumer.
         [PicoDerivedType] on the seed base is what generates the polymorphic serializer in
         THIS assembly — the shape every JSONL store consumer must reproduce. PrivateAssets="none"
         is spelled out for that reason: this project is not packed, but it is the template a
         consumer copies, and the default (contentfiles;analyzers;build) would cut the generator
         and build/PicoJetson.targets off. -->
    <PackageReference Include="PicoJetson" PrivateAssets="none" />
    <ProjectReference Include="..\..\src\PicoActor.Abs\PicoActor.Abs.csproj" />
  </ItemGroup>
</Project>
