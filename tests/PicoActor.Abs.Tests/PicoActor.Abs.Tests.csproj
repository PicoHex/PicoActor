<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- CS0436:多程序集 bridge 生成同名 dispatcher(IVT 交叉可见)——各自使用各自的,行为正确 -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" />
    <!-- 2026.8.1 bridge 生成代码需要(PicoMediator 主包的 MediatorAutoSubscriptionRegistry + PicoDI.Abs) -->
    <PackageReference Include="PicoMediator" />
    <PackageReference Include="PicoDI.Abs" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <ProjectReference Include="..\..\src\PicoActor.Abs\PicoActor.Abs.csproj" />
    <ProjectReference
      Include="..\..\src\PicoActor.Gen\PicoActor.Gen.csproj"
      OutputItemType="Analyzer"
    />
  </ItemGroup>
</Project>
