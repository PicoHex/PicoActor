<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <!-- CS0436: the Mediator bridge generator emits a dispatcher per assembly; a consumer assembly
         and Abs both see one, and each caller correctly uses its own copy. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" />
    <!-- PicoJetson: this is a REGISTRATION CONSUMER. The store's serializer is generated in the
         assembly that declares the [PicoDerivedType] base, so the test events declared here need the
         generator in this compilation. -->
    <PackageReference Include="PicoJetson" />
    <ProjectReference Include="..\..\src\PicoActor.EventStore.Jsonl\PicoActor.EventStore.Jsonl.csproj" />
    <!-- PicoActor: the runtime integration test (JsonlRuntimeSnapshotTests) drives ActorSystem +
         SnapshotEveryNEvents against THIS store, which is the only way to observe that the store
         declares IEventStoreSnapshot — the whole snapshot feature hangs off that is-check. -->
    <ProjectReference Include="..\..\src\PicoActor\PicoActor.csproj" />
    <ProjectReference Include="..\PicoActor.TestSupport\PicoActor.TestSupport.csproj" />
  </ItemGroup>
</Project>
