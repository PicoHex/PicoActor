<Project>
  <!-- ═══════════════════════════════════════════════════════
       PicoActor shared build properties
       ═══════════════════════════════════════════════════════ -->

  <!-- Language baseline — identical for src / tests / samples -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Ecosystem baseline: run the newest analyzer rules available on this SDK -->
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!-- ═══════════════════════════════════════════════════════
       AOT tiering (AotOptimizationLevel)
       minimal (default): reflection-free baseline — PublishAot + full trimming.
       aggressive: minimal + size levers, declared per csproj (Sample/Benchmark).

       Only the tier SELECTION lives here. Tier bodies live in
       Directory.Build.targets, because this file is imported before the project
       body: properties a csproj declares (AotOptimizationLevel, IsPackable,
       TargetFramework) are not visible yet at this point.
       ═══════════════════════════════════════════════════════ -->
  <PropertyGroup>
    <AotOptimizationLevel Condition="'$(AotOptimizationLevel)' == ''">minimal</AotOptimizationLevel>
  </PropertyGroup>

  <!-- ═══════════════════════════════════════════════════════
       General build properties
       ═══════════════════════════════════════════════════════ -->
  <PropertyGroup>
    <!-- Default version for local / non-CI builds -->
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>

    <!-- Central Package Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!-- Committed NuGet lock files (one packages.lock.json per project).
         Directory.Packages.props floats the analyzer-free first-party packages on
         their 2026.<x>.* segment; the lock file is what makes that float reproducible
         (identical graphs locally and in CI) and reviewable (a version move shows up
         as a lock-file diff, not a silent restore-time upgrade).
         CI restores with RestoreLockedMode=true — a stale lock file FAILS the build
         instead of being regenerated. .github/workflows/deps-refresh.yml is the only
         path that intentionally rewrites these files (the force-evaluate flag).

         Caveat worth knowing on the first NU1004: PublishAot=true (see
         Directory.Build.targets) makes the SDK contribute Microsoft.NET.ILLink.Tasks
         and Microsoft.DotNet.ILCompiler as implicit DIRECT dependencies, so a lock
         file also pins the SDK's bundled runtime patch (e.g. 10.0.15). A runner that
         rolls onto a newer 10.0.x band than the lock file was generated on therefore
         fails locked restore with "packages lock file is inconsistent". That is not a
         dependency bug: dispatch deps-refresh.yml and merge its PR to re-stamp the
         SDK band. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- Deterministic builds when CI=true -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Symbol packages for NuGet.org debugging experience -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>

    <!-- Default: use project references for local dev -->
    <UseProjectReferences Condition="'$(UseProjectReferences)' == ''">true</UseProjectReferences>

    <!-- Default: don't pack unless opted in -->
    <IsPackable Condition="'$(IsPackable)' == ''">false</IsPackable>
  </PropertyGroup>

  <!-- ═══════════════════════════════════════════════════════
       SourceLink — packable projects only
       ═══════════════════════════════════════════════════════ -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>
</Project>
