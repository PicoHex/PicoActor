<Project>
  <!-- ═══════════════════════════════════════════════════════
       PicoActor shared build properties
       ═══════════════════════════════════════════════════════ -->

  <!-- Language baseline — identical for src / tests / samples -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Ecosystem baseline: run the newest analyzer rules available on this SDK -->
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!-- ═══════════════════════════════════════════════════════
       AOT tiering (AotOptimizationLevel)
       minimal (default): reflection-free baseline — PublishAot + full trimming.
       aggressive: minimal + size levers, declared per csproj (Sample/Benchmark).

       Only the tier SELECTION lives here. Tier bodies live in
       Directory.Build.targets, because this file is imported before the project
       body: properties a csproj declares (AotOptimizationLevel, IsPackable,
       TargetFramework) are not visible yet at this point.
       ═══════════════════════════════════════════════════════ -->
  <PropertyGroup>
    <AotOptimizationLevel Condition="'$(AotOptimizationLevel)' == ''">minimal</AotOptimizationLevel>
  </PropertyGroup>

  <!-- ═══════════════════════════════════════════════════════
       General build properties
       ═══════════════════════════════════════════════════════ -->
  <PropertyGroup>
    <!-- Default version for local / non-CI builds -->
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>

    <!-- packages.lock.json is a RECORD, not a pin, and this switch is what writes it.

         What floats: the DECLARATIONS in Directory.Packages.props ("which safe range"),
         today.
         What this produces: the packages.lock.json a restore writes beside each project
         ("which exact versions this restore resolved").
         Where it lives: on disk, not in the repository — the file is gitignored. It stays
         out of git because `dotnet publish` adds RID-specific entries
         (Microsoft.DotNet.ILCompiler) to it, so a tracked lock dirtied the tree on every
         release.
         How to answer "which versions did that build use": the `resolved-versions`
         artifact ci.yml uploads (one per leg), not a file in git.

         Deliberately still TRUE: with this off NuGet neither writes nor reads a lock file,
         so a restore resolves silently and leaves nothing to inspect. Untracked is not off. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- Central Package Management is NOT declared here: the single declaration lives
         in Directory.Packages.props (the file that owns the versions), so the flag and
         the PackageVersion items can never be edited apart or disagree. -->

    <!-- Deterministic builds when CI=true -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Symbol packages for NuGet.org debugging experience -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>

    <!-- Default: use project references for local dev -->
    <UseProjectReferences Condition="'$(UseProjectReferences)' == ''">true</UseProjectReferences>

    <!-- Default: don't pack unless opted in -->
    <IsPackable Condition="'$(IsPackable)' == ''">false</IsPackable>
  </PropertyGroup>

  <!-- ═══════════════════════════════════════════════════════
       Restore must stay RID-neutral, or the lock files are not
       host-independent
       ═══════════════════════════════════════════════════════

       PublishAot=true (set per tier in Directory.Build.targets) makes the SDK infer, AT
       RESTORE TIME, a publish RID of

         UseDefaultPublishRuntimeIdentifier = true
         PublishRuntimeIdentifier = $(NETCoreSdkPortableRuntimeIdentifier)

       and append it to RuntimeIdentifiers so the publish-time runtime pack gets a
       restore. That single inference baked a "net10.0/win-x64" dependency group into
       this repo's lock files (local records, never committed): the lock then recorded
       whichever host last refreshed it. CI is a five RID matrix, so a lock generated
       on win-x64 failed locked restore on the linux/osx legs and the other way round,
       with NU1004 "the project's runtime identifiers have changed" — green on one
       leg, red on the other, decided by whoever happened to run the refresh.

       Setting it to false drops the inference: RuntimeIdentifiers stays empty unless a
       RID is actually asked for, so restore resolves the same graph and writes the same
       lock on every host, and no committed lock describes a RID at all.

       Nothing loses its RID: every publish in this repo passes an explicit -r (ci.yml's
       AOT step, once per matrix leg), and a publish that passes -r still restores that
       RID's assets itself. A publish that forgets -r now fails loudly at publish time
       instead of silently baking the host RID into a committed lock.

       Consequence for CI: because the solution restore is RID-neutral, a publish step
       must NOT use the no-restore flag — the assets for net10.0/<rid> are not there and
       it would fail with NETSDK1047. Each publish carries its own -r and restores that
       RID first. (That RID restore does rewrite the lock file beside the project, on
       the runner exactly as on a developer machine, but the file is not tracked:
       packages.lock.json is gitignored in this repo, so a rewritten record can never
       reach a commit, a review or another host. The .gitignore entry is the only guard
       left: there is no locked restore to reject a RID group, so nothing else in the
       build would notice one.)

       (No literal double hyphen appears in this comment: XML comments may not contain
       one, and a props file that does not parse silently loses every property it
       declares — which reads as NU1015, not as a syntax error.) -->
  <PropertyGroup>
    <UseDefaultPublishRuntimeIdentifier>false</UseDefaultPublishRuntimeIdentifier>
  </PropertyGroup>

  <!-- ═══════════════════════════════════════════════════════
       SourceLink — packable projects only
       ═══════════════════════════════════════════════════════ -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <!-- ═══════════════════════════════════════════════════════
       NuGet package icon (the PicoHex family logo)

       The two halves below are a pair and must stay together: PackageIcon
       names the entry inside the package, the None item actually puts the
       file there at the package root. Remove either one and `dotnet pack`
       fails with NU5046 (the icon file does not exist in the package).

       $(MSBuildThisFileDirectory) resolves against THIS file, so the icon is
       always the repository root icon.png, no matter how deep the packing
       project sits. Guarding the item on IsPackable is safe in a props file:
       MSBuild evaluates every item in a pass after every property, so the
       condition already sees the value the csproj body declares.

       PNG here and not the SVG the READMEs use: PackageIcon accepts only PNG
       and JPG. The vector logo lives at assets/picohex.svg.

       (No literal double hyphen appears above: XML comments may not contain
       one, and a props file that does not parse loses every property it
       declares, which surfaces as NU1015, not as a syntax error.)
       ═══════════════════════════════════════════════════════ -->
  <PropertyGroup>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
