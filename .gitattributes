# Normalize line endings in the repository: LF for source and docs.
# (core.autocrlf=true otherwise rewrites the working copy to CRLF and produces
# noisy diffs on every checkout.)
* text=auto eol=lf

*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.slnx text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.ps1 text eol=crlf

*.png binary
*.snupkg binary
*.nupkg binary
